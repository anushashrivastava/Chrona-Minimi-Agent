# Required (both have free tiers, no credit card)
#   Gemini: https://aistudio.google.com/apikey
#   Tavily: https://app.tavily.com
GEMINI_API_KEY=
TAVILY_API_KEY=

# Optional
PORT=3000
# Answer model and fast model (background summaries). Run `npm run doctor` to check they exist for your key.
MODEL=gemini-2.5-flash
FAST_MODEL=gemini-2.5-flash-lite
# Thinking budget in tokens for the answer model. Empty = model default, 0 = off (faster). Measure before changing.
THINKING_BUDGET=
DB_PATH=data/agent.db
DEFAULT_TZ=Asia/Kolkata
# basic = faster/cheaper, advanced = better extraction
SEARCH_DEPTH=basic
# Lets tests and evals override "now" via the x-fake-now header (never enable in prod)
ALLOW_FAKE_NOW=0
