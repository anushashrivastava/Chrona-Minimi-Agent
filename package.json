{
  "name": "minimi-chat-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chat agent with one tool (web search) and time-aware memory.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch --disable-warning=ExperimentalWarning --env-file-if-exists=.env src/server.ts",
    "start": "tsx --disable-warning=ExperimentalWarning --env-file-if-exists=.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "check:memory": "tsx --disable-warning=ExperimentalWarning evals/memory-check.ts",
    "doctor": "tsx --disable-warning=ExperimentalWarning --env-file-if-exists=.env scripts/doctor.ts",
    "eval": "tsx --disable-warning=ExperimentalWarning --env-file-if-exists=.env evals/run.ts",
    "check:loop": "tsx --disable-warning=ExperimentalWarning evals/loop-check.ts"
  },
  "dependencies": {
    "@google/genai": "^3.3.0",
    "@hono/node-server": "^2.1.8",
    "chrono-node": "^2.10.3",
    "hono": "^4.13.18"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
